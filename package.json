		"nodemon": "^3.1.14",
		"prettier": "^3.10.1",
		"ts-node": "^10.9.2",
		"tslib": "^2.9.1",
		"typescript": "~6.0.3"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1169.0",
		"@aws-sdk/client-ssm": "^3.1169.0",
		"@aws-sdk/credential-provider-node": "^3.972.97",
