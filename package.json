	"prettier": "@guardian/prettier",
	"scripts": {
		"test": "node --require ts-node/register --test src/*.test.ts",
		"typecheck": "tsc --noEmit",
		"build": "esbuild --bundle --platform=node --target=node24 --outfile=dist/index.js src/index.ts",
